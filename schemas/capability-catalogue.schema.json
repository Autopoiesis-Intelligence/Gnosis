{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Autopoiesis-Intelligence/Gnosis/blob/main/schemas/capability-catalogue.schema.json",
  "title": "Gnosis Capability Catalogue",
  "description": "Versioned inventory of capabilities and their provenance. Catalogue membership never grants execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "ciEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "run_id",
        "conclusion",
        "commit_sha",
        "url"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "conclusion": {
          "const": "success"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "title",
        "repository",
        "source_revision",
        "evidence_status",
        "operations",
        "permissions",
        "data_classes",
        "dependencies",
        "limits",
        "failure_modes",
        "maintenance",
        "rollback",
        "ci_evidence"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "evidence_status": {
          "enum": [
            "DOCUMENTED",
            "IMPLEMENTED",
            "TESTED",
            "CI_PROVEN",
            "RUNTIME_PROVEN",
            "UNRESOLVED"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maintenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ci_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ciEvidence"
          }
        }
      }
    }
  }
}
